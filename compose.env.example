# Documentation only. Generate a real ignored file with scripts/compose.ps1 -Action Init.
# .env supplies interpolation values; only environment: entries reach containers.
COMPOSE_PROJECT_NAME=university-local
API_PORT=18080
API_IMAGE=university-registration:day52
SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# Set Y only after accepting the SQL Server Developer license (development/test only).
ACCEPT_EULA=
SQL_SA_PASSWORD=
SQL_RUNTIME_PASSWORD=
